<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================= -->
    <!--  PERMISSIONS                                                  -->
    <!-- ============================================================= -->

    <!-- Vignette flottante par-dessus les autres applications -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service pour maintenir l'overlay actif (API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Type explicite requis à partir d'Android 14 (API 34) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification du foreground service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Demander l'exclusion de l'optimisation batterie (Doze) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      L'accès à l'AccessibilityService n'exige PAS de <uses-permission> côté app :
      c'est le SERVICE qui se protège via android:permission="BIND_ACCESSIBILITY_SERVICE"
      (voir plus bas). L'utilisateur active le service manuellement dans les Réglages.
    -->

    <application
        android:name=".DriveeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveeCopilote"
        tools:targetApi="34">

        <!-- ========================================================= -->
        <!--  ACTIVITÉ PRINCIPALE (Compose)                            -->
        <!-- ========================================================= -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DriveeCopilote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================================================= -->
        <!--  SERVICE D'ACCESSIBILITÉ (le "scraper" d'écran)           -->
        <!--  Doit être protégé par BIND_ACCESSIBILITY_SERVICE afin    -->
        <!--  que seul le système puisse s'y lier.                     -->
        <!-- ========================================================= -->
        <service
            android:name=".service.accessibility.RideAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <!-- Fichier de configuration des flags/paquets écoutés -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ========================================================= -->
        <!--  SERVICE OVERLAY (foreground) — vignette flottante        -->
        <!--  foregroundServiceType="specialUse" requis Android 14+.   -->
        <!-- ========================================================= -->
        <service
            android:name=".service.overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Justification requise à partir d'Android 14 pour specialUse -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Affichage d'une vignette d'aide à la conduite (rentabilité) par-dessus l'application VTC active." />
        </service>

        <!-- ========================================================= -->
        <!--  FILE PROVIDER — partage du fichier CSV exporté           -->
        <!-- ========================================================= -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
