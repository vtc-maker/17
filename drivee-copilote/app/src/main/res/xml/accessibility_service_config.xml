<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuration du RideAccessibilityService.

    Flags indispensables :
    - flagReportViewIds : expose les resource-id des vues (utile pour cibler
      précisément un champ, ex: com.ubercab.driver:id/fare_amount).
    - flagRetrieveInteractiveWindows : permet de lire les fenêtres superposées
      (une offre de course apparaît souvent dans une fenêtre/overlay au-dessus).
    - flagIncludeNotImportantViews : certaines vues de texte ne sont pas marquées
      "importantes pour l'accessibilité" — on les inclut pour ne rien rater.

    canRetrieveWindowContent="true" est OBLIGATOIRE pour parcourir l'arborescence
    des AccessibilityNodeInfo (getRootInActiveWindow / getWindows).

    accessibilityEventTypes : on écoute les changements de contenu ET d'état de
    fenêtre pour capter l'apparition/disparition d'une offre.

    packageNames : on RESTREINT l'écoute aux seules apps VTC ciblées afin de
    minimiser l'empreinte (performance + respect de la vie privée).
    Retirer cet attribut ferait écouter TOUTES les apps (déconseillé).

    notificationTimeout : anti-rebond. 100 ms évite de traiter chaque micro-changement.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagDefault"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.ubercab.driver,ee.mtakso.driver"
    android:settingsActivity="com.drivee.copilote.ui.MainActivity" />
